---
import { ChevronDown, ChevronRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';

import HeroPicMobile from '@assets/images/faq-page/hero-7-mobile.jpg';
import HeroPic from '@assets/images/faq-page/hero-7.jpg';
const mobileImage = await getImage({
  src: HeroPicMobile,
  widths: [400, 640, 800, 1024],
  sizes: '100vw',
  format: 'webp',
});
const faqs = await getCollection('faqs');
const categories = [
  {
    label: 'Getting Started',
    value: 'getting-started',
  },
  {
    label: 'Specialties',
    value: 'specialties',
  },
  {
    label: 'Payment & Insurance',
    value: 'payment-insurance',
  },
  {
    label: 'Appointments & Treatment',
    value: 'appointments-treatment',
  },
];

const groupedFaqs = categories.map((category) => ({
  ...category,

  faqs: faqs
    .filter((faq) => faq.data.category === category.value)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout title="faq" hasWave={false}>
  <section class="relative overflow-hidden">
    <div class="relative hero-container">
      <picture>
        <source
          media="(max-width: 600px)"
          srcset={mobileImage.srcSet.attribute}
          sizes="100vw"
          type="image/webp"
        />

        <Image
          src={HeroPic}
          alt="Elie"
          widths={[350, 480, 640, 960, 1200, 1600, 2400]}
          sizes="100vw"
          class="hero-image"
        />
      </picture>

      <div class="hero-edge-gradient"></div>

      <!-- Main left-side gradient -->
      <!-- Main gradient -->
      <div class="hero-gradient"></div>

      <!-- Text overlay -->
      <div
        class="absolute left-6 top-1/2 z-10
             -translate-y-1/2
             text-deeper-teal
             md:left-[8%]
             md:top-1/3"
      >
        <h1
          class="text-reveal font-cormorant
               text-2xl font-semibold leading-[0.95]
               sm:text-4xl
               md:text-5xl
               lg:text-6xl"
        >
          FAQ
        </h1>

        <!-- <p
          class="text-reveal-late mt-3 text-base leading-snug text-deeper-teal/90
               sm:text-lg
               md:text-xl
               lg:text-3xl"
        >
          The person behind<br />
          MVMNT Matters
        </p> -->
      </div>
    </div>
  </section>

  <div class="bg-sand-bg">
    <section class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="mb-10 text-center text-3xl font-semibold text-stone-950">
        Frequently Asked Questions
      </h1>

      {
        groupedFaqs.map((group) => (
          <div class="mb-12">
            <h2 class="mb-2 text-xl font-semibold text-deeper-teal ">
              {group.label}
            </h2>
            <div class="mt-2 h-px w-12 bg-" />

            <div class="space-y-3">
              {group.faqs.map((faq) => (
                <details class="group text-sm md:text-lg collapse border-b border-deeper-teal/40">
                  <summary class=" collapse-title flex cursor-pointer items-center justify-between text-stone-800 ">
                    <span>{faq.data.question}</span>

                    <ChevronRight
                      className="size-5 shrink-0 transition-transform duration-300 group-open:rotate-90"
                      strokeWidth={1.5}
                    />
                  </summary>

                  <div class="collapse-content">
                    <p class="text-base whitespace-pre-wrap leading-relaxed">
                      {faq.data.answer}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  details::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 300ms ease,
      opacity 200ms ease,
      content-visibility 300ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @media (min-width: 380px) {
    .hero-image {
      display: block;
      width: 100%;
      height: auto;

      mask-image: linear-gradient(to right, transparent 0%, black 60%);
    }
  }

  @media (min-width: 1100px) {
    .hero-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      position: absolute;
      right: 0;
      top: 0;
    }
    .hero-container {
      position: relative;
      overflow: hidden;
      height: clamp(750px, 60vw, 900px);
    }
    .hero-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        #f9fafb 0%,
        rgb(243 244 246 / 15%) 27%,
        transparent 64%
      );
    }
    /* Image-edge fade follows the image's left boundary. */
    .hero-edge-gradient {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(0% + 0px);
      width: 224px;
      transform: translateX(-50%);
      pointer-events: none;
      background: linear-gradient(
        to right,
        #f9fafb 0%,
        rgb(243 244 246 / 95%) 50%,
        transparent 100%
      );
      display: none;
    }
  }
  @media (min-width: 1600px) {
    .hero-image {
      width: 95%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      position: absolute;
      right: 0;
      top: 0;
    }
    .hero-container {
      position: relative;
      overflow: hidden;
      height: clamp(900px, 50vw, 1100px);
    }
    .hero-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        #f3f4f6 0%,
        rgb(243 244 246 / 55%) 25%,
        transparent 63%
      );
    }
    /* Image-edge fade follows the image's left boundary. */
    .hero-edge-gradient {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(15% + 90px);
      width: 444px;
      transform: translateX(-50%);
      pointer-events: none;
      background: linear-gradient(
        to right,
        #f3f4f6 0%,
        rgb(243 244 246 / 90%) 55%,
        transparent 100%
      );
      display: block;
    }
  }
</style>
