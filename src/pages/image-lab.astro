---
import ImageLab from '../components/ImageLab';
import '../styles/global.css';
import AboutPic from '../assets/images/about-image/story-11.jpg';
import ServicesPic from '../assets/images/services/hero-8.jpg';
import ServicesPicMobile from '../assets/images/services/hero-9.jpg';
import ServicesAboveFooter from '../assets/images/services/AboveFooter-19.jpg';
import ServicesAboveFooterMobile from '../assets/images/services/above-footer-mobile-20.jpg';
import HomePageHero from '../assets/images/homepage/hero-2.jpg';
import FaqHero from '@assets/images/faq-page/hero-7.jpg';
import FaqHeroMobile from '@assets/images/faq-page/hero-7-mobile.jpg';
import ContactHero from '@assets/images/services/hero.jpg';
import ContactHeroMobile from '@assets/images/services/hero-mobile.jpg';
import ContactAboveFooter from '@assets/images/contact-page/above-footer-15.jpg';

const images = [
  { name: 'About Hero', src: AboutPic.src },
  { name: 'Services Hero', src: ServicesPic.src },
  { name: 'Services Hero Mobile', src: ServicesPicMobile.src },
  { name: 'Services Above Footer', src: ServicesAboveFooter.src },
  { name: 'Services Above Footer Mobile', src: ServicesAboveFooterMobile.src },
  { name: 'Home Hero', src: HomePageHero.src },
  { name: 'FAQ Hero', src: FaqHero.src },
  { name: 'FAQ Hero Mobile', src: FaqHeroMobile.src },
  { name: 'Contact Hero', src: ContactHero.src },
  { name: 'Contact Hero Mobile', src: ContactHeroMobile.src },
  { name: 'Contact Above Footer', src: ContactAboveFooter.src },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Image Lab</title>
  </head>
  <body>
    <ImageLab client:load images={images} />
  </body>
</html>
